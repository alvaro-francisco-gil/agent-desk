#!/usr/bin/env python3
"""Paste the last dictation where you are typing (Shift+F9), keeping your clipboard.

Voxtype keeps no history file, so this reads its journal, which holds the text before
voxtype's replacements; they are applied here, so the paste is what voxtype typed. The
daemon must run with -v: since 1.3 voxtype logs the dictated text only at debug.
It pastes the way voxtype does: the text goes on the clipboard, Shift+Insert is
pressed, and what the clipboard held before is put back. When no key can be pressed,
the text stays on the clipboard. Installed by tasks/dictation.yml.
"""

import os
import re
import subprocess
import sys
import time
import tomllib
from pathlib import Path

DAYS = 7
TITLE = "Last dictation"
TRANSCRIBED = re.compile(r'Transcribed: "(.*)"$')
# Voxtype 1.3 logs these for every dictation; the text itself only at debug (-v).
STARTED = re.compile(r"Recording started")
COUNTED = re.compile(r"Transcribed \d+ chars")
# Long enough for the window to read the clipboard before it is put back (voxtype: 200).
RESTORE_AFTER = 0.3
NO_TEXT = "voxtype logged your last dictation without its text: is the daemon running with -v?"


class TextNotLogged(Exception):
    """The newest dictation was logged by length only, so its text is not in the journal."""


def notify(summary: str, body: str = "") -> None:
    subprocess.run(["notify-send", "-t", "15000", summary, body], check=False)


def last_dictation() -> str | None:
    """The newest transcript in the journal, or None when there is none.

    Raises TextNotLogged when a newer dictation than the last one with text was logged
    by length only, rather than hand back an older dictation as the last."""
    done = subprocess.run(
        ["journalctl", "--user", "-u", "voxtype", "--since", f"{DAYS} days ago",
         "-o", "cat", "--no-pager"],
        capture_output=True,
        text=True,
        check=True,
    )
    counted = False
    for line in reversed(done.stdout.splitlines()):
        match = TRANSCRIBED.search(line)
        if match:
            return match.group(1)
        if COUNTED.search(line):
            counted = True
        elif STARTED.search(line):
            if counted:
                raise TextNotLogged
            counted = False
    if counted:
        raise TextNotLogged
    return None


def replacements(home: Path) -> dict[str, str]:
    config = home / ".config/voxtype/config.toml"
    if not config.exists():
        return {}
    return tomllib.loads(config.read_text()).get("text", {}).get("replacements", {})


def apply_replacements(text: str, found: dict[str, str]) -> str:
    """What voxtype typed: its journal holds the text before its replacements."""
    for wrong, right in found.items():
        text = re.sub(rf"\b{re.escape(wrong)}\b", right, text, flags=re.IGNORECASE)
    return text


def wayland() -> bool:
    return bool(os.environ.get("WAYLAND_DISPLAY"))


def copy(data: bytes, kind: str | None = None) -> None:
    """wl-copy on Wayland, xclip on X11 (a GNOME session can be either)."""
    if wayland():
        argv = ["wl-copy"] + (["--type", kind] if kind else [])
    else:
        argv = ["xclip", "-selection", "clipboard"] + (["-t", kind] if kind else [])
    subprocess.run(argv, input=data, check=True)


TEXT_KINDS = ("text/plain;charset=utf-8", "UTF8_STRING", "text/plain")


def pick(kinds: list[str]) -> str | None:
    """Plain text when the clipboard has it (a copy from Chrome lists HTML first), else
    its first real type: X11 also lists TARGETS and TIMESTAMP."""
    for kind in TEXT_KINDS:
        if kind in kinds:
            return kind
    return next((kind for kind in kinds if "/" in kind), None)


def clipboard() -> tuple[str, bytes] | None:
    """What the clipboard holds, as its first type and its bytes; None when empty."""
    if wayland():
        types = ["wl-paste", "--list-types"]
        read = ["wl-paste", "--no-newline", "--type"]
    else:
        types = ["xclip", "-selection", "clipboard", "-o", "-t", "TARGETS"]
        read = ["xclip", "-selection", "clipboard", "-o", "-t"]
    try:
        listed = subprocess.run(types, capture_output=True, text=True, check=True).stdout.split()
        kind = pick(listed)
        if kind is None:
            return None
        held = subprocess.run(read + [kind], capture_output=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    return kind, held


def put_back(held: tuple[str, bytes] | None) -> None:
    try:
        if held:
            copy(held[1], held[0])
        elif wayland():
            subprocess.run(["wl-copy", "--clear"], check=True)
    except (OSError, subprocess.CalledProcessError):
        pass


# Shift+Insert pastes in Chrome and in Ghostty. wtype works on wlroots desktops,
# dotool and ydotool on GNOME's Wayland too, xdotool on X11: the first that works.
PRESS_WAYLAND = [
    (["wtype", "-M", "shift", "-k", "Insert", "-m", "shift"], None),
    (["dotool"], b"key shift+insert\n"),
    (["ydotool", "key", "42:1", "110:1", "110:0", "42:0"], None),
]
PRESS_X11 = [(["xdotool", "key", "shift+Insert"], None)]


def press_paste() -> bool:
    for argv, given in PRESS_WAYLAND if wayland() else PRESS_X11:
        try:
            subprocess.run(argv, input=given, capture_output=True, check=True, timeout=5)
        except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
            continue
        return True
    return False


def paste(text: str) -> bool:
    """Paste text where the cursor is and put the clipboard back; False when no key
    could be pressed, so the text is left on the clipboard. Raises when it can't copy."""
    held = clipboard()
    copy(text.encode())
    if not press_paste():
        return False
    time.sleep(RESTORE_AFTER)
    put_back(held)
    return True


def main() -> int:
    try:
        said = last_dictation()
    except (OSError, subprocess.CalledProcessError):
        notify(TITLE, "Could not read voxtype's log")
        return 1
    except TextNotLogged:
        notify(TITLE, NO_TEXT)
        return 1
    if said is None:
        notify(TITLE, f"Nothing dictated in the last {DAYS} days")
        return 0
    text = apply_replacements(said, replacements(Path.home()))
    try:
        pasted = paste(text)
    except (OSError, subprocess.CalledProcessError):
        notify(f"{TITLE} (not pasted)", text)
        return 1
    if not pasted:
        notify(f"{TITLE} (copied, could not paste)", text)
        return 1
    return 0

if __name__ == "__main__":
    sys.exit(main())
